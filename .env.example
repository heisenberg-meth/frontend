# Frontend Environment Variables
# Copy this file to .env and fill in the values

# API URL — set this for production/ngrok, leave empty for local proxy
# Local: empty (uses Vite proxy to localhost:5000)
# Remote: full URL with trailing slash
VITE_API_URL=

# Optional: Explicit proxy target for Vite dev server
# Overrides VITE_API_URL for proxy configuration only
# VITE_PROXY_TARGET=http://localhost:5000
